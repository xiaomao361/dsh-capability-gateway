{
  "name": "dsh-capability-gateway",
  "version": "0.4.0",
  "private": false,
  "license": "MIT",
  "author": "Zhou Wei",
  "description": "One on-demand gateway for opt-in third-party skills and MCP tools",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "client.js",
    "observability.js",
    "remote.js",
    "search.js",
    "report.js",
    "validation.js",
    "CHANGELOG.md",
    "docs/DESIGN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check index.js && node --check observability.js && node --check remote.js && node --check client.js && node --check search.js && node --check validation.js && node --check report.js"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-test-renderer": "^18.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaomao361/dsh-capability-gateway.git"
  },
  "homepage": "https://github.com/xiaomao361/dsh-capability-gateway#readme",
  "bugs": {
    "url": "https://github.com/xiaomao361/dsh-capability-gateway/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "mcp",
    "skills",
    "capability",
    "context"
  ]
}
